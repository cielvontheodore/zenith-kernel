# Zenith Kernel Kconfig fragment
#
# Applied via `scripts/kconfig/merge_config.sh -m .config zenith.config`
# AFTER `make LSMOD=modprobed.db localmodconfig`, so everything listed here
# survives even if modprobed.db is incomplete or from a different point in
# time than the current hardware/config. `make olddefconfig` runs after this
# to resolve any newly-enabled dependencies.
#
# Symbol names occasionally move between kernel releases. If a symbol below
# no longer exists for kernelVersion, `merge_config.sh` prints a warning
# (not a hard failure) during the CI build log — check it after bumping the
# kernel version.

# --- Compiler / LTO --------------------------------------------------------
# Requires stdenv = clang/lld (see kernel.nix) and LLVM=1 LLVM_IAS=1.
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_NONE is not set
# CONFIG_LTO_CLANG_FULL is not set

# Deliberately NOT setting CC_OPTIMIZE_FOR_SIZE/PERFORMANCE here: the
# kernel's own default optimization level (-O2, CC_OPTIMIZE_FOR_PERFORMANCE)
# is left untouched. See kernel.nix header comment / README.md for why -O3
# is not used.

# --- CPU tuning ---------------------------------------------------------
# Deliberately NOT done here. There is no in-tree (or currently-reachable
# out-of-tree) Kconfig symbol for x86-64 ISA levels -- x86-64-v3 targeting
# is applied as a KCFLAGS environment override in kernel.nix instead
# (`-march=x86-64-v3` plus explicit `-mno-sse*/-mno-avx*/-mno-fma` to keep
# the kernel's no-FPU-in-general-context invariant intact). See kernel.nix
# and README.md for the full rationale.
CONFIG_GENERIC_CPU=y

# --- Scheduler (requires the BORE patch) -----------------------------------
CONFIG_SCHED_BORE=y

# --- Preemption model -------------------------------------------------------
CONFIG_PREEMPT_BUILD=y
CONFIG_PREEMPT=y
CONFIG_PREEMPTION=y
CONFIG_PREEMPT_COUNT=y
CONFIG_PREEMPT_DYNAMIC=y
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set

# --- Timer frequency ---------------------------------------------------------
CONFIG_HZ_1000=y
CONFIG_HZ=1000
# CONFIG_HZ_100 is not set
# CONFIG_HZ_250 is not set
# CONFIG_HZ_300 is not set

# --- ThinkPad T480 hardware essentials --------------------------------------
# Forced back on regardless of what localmodconfig decided, because these
# are known-required for this specific machine.
CONFIG_ACPI=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_THINKPAD_ACPI=m
CONFIG_THINKPAD_ACPI_HOTKEY_POLL=y

CONFIG_SENSORS_CORETEMP=m

CONFIG_POWERCAP=y
CONFIG_INTEL_RAPL=m
CONFIG_INTEL_RAPL_CORE=m

# Kaby Lake R (8th-gen, T480) integrated graphics
CONFIG_DRM=y
CONFIG_DRM_I915=m

# NIC / Wi-Fi
CONFIG_E1000E=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m

# NVMe storage, xHCI USB, HID over I2C (trackpad/trackpoint on newer T480 units)
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_USB_XHCI_HCD=y
CONFIG_I2C_HID=m
CONFIG_PINCTRL_SUNRISEPOINT=y

# --- Suspend/resume, filesystems, base networking ---------------------------
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

CONFIG_NETFILTER=y
CONFIG_INET=y
CONFIG_IPV6=y

CONFIG_EFI_STUB=y
CONFIG_IA32_EMULATION=y

CONFIG_BTRFS_FS=y
CONFIG_CRYPTO_BLAKE2B=y
CONFIG_CRYPTO_XXHASH=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_CRYPTO_CRC32=y